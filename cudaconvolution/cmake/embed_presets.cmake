# Generates a C++ source holding JSON files as byte arrays, returned by <FUNC>() (default embedded_presets):
# cmake -DOUT=<cpp> -DFILES=<a.json;b.json> [-DFUNC=name] -P embed_presets.cmake
if(NOT FUNC)
  set(FUNC embedded_presets)
endif()
set(body "// generated by cmake/embed_presets.cmake - do not edit\n#include \"core/presets.h\"\n\nnamespace cudaconvolution {\n\n")
set(table "")
set(i 0)
foreach(f IN LISTS FILES)
  get_filename_component(name ${f} NAME_WE)
  file(READ ${f} hex HEX)
  # emit as a byte array: no limit on string literal length, no escaping issues
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n  " bytes "${bytes}")
  string(APPEND body "static const char preset_${i}[] = {\n  ${bytes}0x00};\n\n")
  string(APPEND table "  {\"${name}\", preset_${i}, sizeof(preset_${i}) - 1},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "static const EmbeddedPreset table[] = {\n${table}  {nullptr, nullptr, 0}};\n\n")
string(APPEND body "const EmbeddedPreset* ${FUNC}() { return table; }\n\n}  // namespace cudaconvolution\n")
file(WRITE ${OUT}.tmp "${body}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUT}.tmp)
