#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// k_level of Sources/cuda/mvcuda_super.cu: one reduction level with its padding in one pass (RB2CubicVertical /
// RB2BilinearFilteredVertical rounded to the sample type, then the horizontal pass). Workgroups (ceil(max ew / 32),
// ceil(max eh / 8), planes).

layout(local_size_x = 32, local_size_y = 8) in;

struct Args
{
  uint64_t dst[3], src[3];
  int dd[18];   // per plane w, h, hpad, vpad, ew, eh of the new level
  int sd[18];   // the same of the level above
  int cubic, pad_;
};
ARGS(Args)

uint64_t g_src;
int g_ew, g_hpad, g_vpad;

int at(int x, int y)
{
  return ldpix(g_src, uint(y + g_vpad) * uint(g_ew) + uint(x + g_hpad));
}

int reduce_v_at(int x, int y, int nh, int cubic)
{
  if (y == 0 || y == nh - 1)
    return (at(x, 2 * y) + at(x, 2 * y + 1) + 1) >> 1;
  if (cubic == 0)
    return (at(x, 2 * y - 1) + at(x, 2 * y) * 3 + at(x, 2 * y + 1) * 3 + at(x, 2 * y + 2) + 4) >> 3;
  return (at(x, 2 * y - 2) + at(x, 2 * y - 1) * 5 + at(x, 2 * y) * 10 + at(x, 2 * y + 1) * 10 + at(x, 2 * y + 2) * 5
    + at(x, 2 * y + 3) + 16) >> 5;
}

void main()
{
  const int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y), p = int(gl_WorkGroupID.z);
  const int nw = A.dd[p * 6], nh = A.dd[p * 6 + 1], hpad = A.dd[p * 6 + 2], vpad = A.dd[p * 6 + 3], ew = A.dd[p * 6 + 4], eh = A.dd[p * 6 + 5];
  if (x >= ew || y >= eh)
    return;
  g_src = A.src[p];
  g_hpad = A.sd[p * 6 + 2];
  g_vpad = A.sd[p * 6 + 3];
  g_ew = A.sd[p * 6 + 4];
  const int cubic = A.cubic;
  const int cx = min(max(x - hpad, 0), nw - 1), cy = min(max(y - vpad, 0), nh - 1);
#define RV(c) reduce_v_at((c), cy, nh, cubic)
  int v;
  if (cx == 0 || cx == nw - 1)
    v = (RV(2 * cx) + RV(2 * cx + 1) + 1) >> 1;
  else if (cubic == 0)
    v = (RV(2 * cx - 1) + RV(2 * cx) * 3 + RV(2 * cx + 1) * 3 + RV(2 * cx + 2) + 4) >> 3;
  else
    v = (RV(2 * cx - 2) + RV(2 * cx - 1) * 5 + RV(2 * cx) * 10 + RV(2 * cx + 1) * 10 + RV(2 * cx + 2) * 5 + RV(2 * cx + 3) + 16) >> 5;
#undef RV
  stpix(A.dst[p], uint(y) * uint(ew) + uint(x), v);
}
