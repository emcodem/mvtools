#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// k_wiener_h / k_wiener_v of Sources/cuda/mvcuda_super.cu (HorizontalWiener / VerticalWiener over the whole extended
// plane). Several jobs per dispatch: job z = gl_WorkGroupID.z (dst, src, W, H, vertical). Workgroups (ceil(max W / 32),
// ceil(max H / 8), jobs).

layout(local_size_x = 32, local_size_y = 8) in;

struct Args
{
  uint64_t dst[6], src[6];
  int W[6], H[6], vert[6];
  int maxv, njobs;
};
ARGS(Args)

int wiener6(int a, int b, int c, int d, int e, int f, int maxv)
{
  const int v = (a + (-b + (c << 2) + (d << 2) - e) * 5 + f + 16) >> 5;
  return min(maxv, max(0, v));
}

void main()
{
  const int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y), j = int(gl_WorkGroupID.z);
  const int W = A.W[j], H = A.H[j];
  if (x >= W || y >= H)
    return;
  const uint64_t s = A.src[j];
  const uint o = uint(y) * uint(W) + uint(x);
  const int maxv = A.maxv;
  int v;
  if (A.vert[j] == 0)
  {
    if (x < 2)
      v = (ldpix(s, o) + ldpix(s, o + 1) + 1) >> 1;
    else if (x < W - 4)
      v = wiener6(ldpix(s, o - 2), ldpix(s, o - 1), ldpix(s, o), ldpix(s, o + 1), ldpix(s, o + 2), ldpix(s, o + 3), maxv);
    else if (x < W - 1)
      v = (ldpix(s, o) + ldpix(s, o + 1) + 1) >> 1;
    else
      v = ldpix(s, o);
  }
  else
  {
    const uint w = uint(W);
    if (y < 2)
      v = (ldpix(s, o) + ldpix(s, o + w) + 1) >> 1;
    else if (y < H - 4)
      v = wiener6(ldpix(s, o - 2 * w), ldpix(s, o - w), ldpix(s, o), ldpix(s, o + w), ldpix(s, o + 2 * w), ldpix(s, o + 3 * w), maxv);
    else if (y < H - 1)
      v = (ldpix(s, o) + ldpix(s, o + w) + 1) >> 1;
    else
      v = ldpix(s, o);
  }
  stpix(A.dst[j], o, v);
}
